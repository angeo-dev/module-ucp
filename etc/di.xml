<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Bind the ProfileGenerator interface to its implementation. The
        controller and the validate CLI depend on the interface.
    -->
    <preference for="Angeo\Ucp\Api\ProfileGeneratorInterface"
                type="Angeo\Ucp\Model\ProfileGenerator"/>

    <!--
        NOTE: the custom router is registered in etc/frontend/di.xml, NOT here.
        The frontend "standard" RouterList is frontend-scoped; registering the
        router in global di.xml does not reliably wire it into frontend routing.
    -->

    <!--
        Service binding provider pool. Each provider contributes transport
        bindings to the ucp.services registry; fragments for the same
        service name are merged (bindings appended). Third-party modules
        add their own providers here via their own di.xml.
    -->
    <type name="Angeo\Ucp\Model\ProfileGenerator">
        <arguments>
            <argument name="serviceBindingProviders" xsi:type="array">
                <item name="shopping_rest" xsi:type="object">Angeo\Ucp\Model\Service\RestShoppingBindingProvider</item>
                <item name="shopping_mcp" xsi:type="object">Angeo\Ucp\Model\Service\McpShoppingBindingProvider</item>
            </argument>
        </arguments>
    </type>

    <!-- CLI commands. -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="angeo_ucp_keys_generate" xsi:type="object">Angeo\Ucp\Console\Command\GenerateKeysCommand</item>
                <item name="angeo_ucp_validate" xsi:type="object">Angeo\Ucp\Console\Command\ValidateProfileCommand</item>
            </argument>
        </arguments>
    </type>
    <preference for="Angeo\Ucp\Api\SignatureVerifierInterface"
                type="Angeo\Ucp\Model\Signature\SignatureVerifier"/>
</config>
