<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <angeo_ucp>
            <general>
                <enabled>0</enabled>
            </general>
            <capabilities>
                <catalog_search_enabled>0</catalog_search_enabled>
                <catalog_lookup_enabled>0</catalog_lookup_enabled>
                <cart_enabled>0</cart_enabled>
                <checkout_enabled>0</checkout_enabled>
                <order_enabled>0</order_enabled>
                <identity_linking_enabled>0</identity_linking_enabled>
                <identity_linking_scopes></identity_linking_scopes>
                <permalink_enabled>0</permalink_enabled>
                <permalink_endpoint></permalink_endpoint>
            </capabilities>
            <extensions>
                <fulfillment_enabled>0</fulfillment_enabled>
                <discount_enabled>0</discount_enabled>
                <buyer_consent_enabled>0</buyer_consent_enabled>
            </extensions>
            <transport>
                <rest_endpoint></rest_endpoint>
            </transport>
            <keys>
                <signing_key_jwk></signing_key_jwk>
            </keys>
            <advanced>
                <supported_versions></supported_versions>
                <payment_handlers></payment_handlers>
            </advanced>
            <security>
                    <!--
                        Disabled by default. No agent signs requests to a store
                        that has never advertised signature support, so
                        defaulting to "required" would reject every existing
                        integration the moment this module is upgraded.
                    -->
                    <inbound_signature_mode>disabled</inbound_signature_mode>
                </security>
            </angeo_ucp>
    </default>
</config>
