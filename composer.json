{
    "name": "angeo/module-ucp",
    "description": "Spec-compliant Universal Commerce Protocol (UCP) profile generator for Magento 2. Serves /.well-known/ucp at protocol version 2026-08-25 with the canonical keys[] JWK Set (ES256/ES384/Ed25519), authority-bound capability schemas, and correct hosting/CORS headers.",
    "type": "magento2-module",
    "version": "2.1.0",
    "license": "MIT",
    "keywords": [
        "magento2",
        "magento 2 module",
        "ucp",
        "universal commerce protocol",
        "agentic commerce",
        "ai agents",
        "web bot auth",
        "well-known",
        "jwk",
        "aeo",
        "angeo"
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "magento/framework": ">=103.0.0",
        "magento/module-backend": ">=102.0.0",
        "magento/module-config": ">=101.0.0",
        "magento/module-store": ">=101.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "magento/magento-coding-standard": "*",
        "phpstan/phpstan": "^1.10"
    },
    "authors": [
        {
            "name": "Ievgenii Gryshkun",
            "email": "info@angeo.dev",
            "homepage": "https://angeo.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/angeo-dev/module-ucp/issues",
        "source": "https://github.com/angeo-dev/module-ucp"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Angeo\\Ucp\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Angeo\\Ucp\\Test\\": "Test/"
        }
    },
    "suggest": {
        "ext-sodium": "Required only for Ed25519 (EdDSA) signing keys, which the UCP spec recommends for Web Bot Auth interop. ES256 works without it.",
        "angeo/module-ucp-catalog": "Serves the catalog.search / catalog.lookup / get_product endpoints this profile advertises"
    }
}
